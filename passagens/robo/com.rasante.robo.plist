<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rasante. · agenda o robô das passagens para 07:00 e 19:00, todo dia.
     Se o Mac estiver desligado nessa hora, o robô roda quando você ligar e entrar na sua conta. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.rasante.robo</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/matheuscatani/.nvm/versions/node/v24.14.1/bin/node</string>
    <string>/Users/matheuscatani/APP BUSCAS/passagens/robo/voar.mjs</string>
    <string>--agendado</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/matheuscatani/APP BUSCAS</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/matheuscatani/APP BUSCAS/passagens/robo/agendado.log</string>
  <key>StandardErrorPath</key><string>/Users/matheuscatani/APP BUSCAS/passagens/robo/agendado.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string></dict>
</dict>
</plist>
